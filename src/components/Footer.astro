---
interface Props {
  aktivna?: "pocetna" | "proizvodi" | "katalog" | "o-nama" | "kontakt";
}
const { aktivna } = Astro.props;

const godina = new Date().getFullYear();

const adresa = "Novoseljanski put 139A, 26000 Pančevo, Srbija";
const mapaSrc = `https://www.google.com/maps?q=${encodeURIComponent(adresa)}&output=embed`;

/* MAPA U PODNOŽJU IDE SAMO NA POČETNOJ.

   Ranije je stajala na svih 61 stranu (svuda osim `/kontakt`, koji ima
   svoju uz adresu). To je značilo da SVAKA strana učitava Google Maps —
   najskuplji resurs na sajtu, uz to i pitanje pristanka, a na strani
   proizvoda ili u katalogu mapu niko nije tražio.

   Odluka korisnika (2026-09-16): mapa ostaje ŽIVA i vidljiva, ali samo
   tamo gde ima posla — na početnoj i na `/kontakt`. Ukupno dve strane
   umesto šezdeset jedne. */
const prikaziMapu = aktivna === "pocetna";
---

<footer class="podnozje">
  <div class="shell">
    <div class="vrh">
      <div class="vrh-tekst">
        <a href="/" class="znak" aria-label="BSP — početna">BSP</a>
        <p class="t-lead recenica">
          Proizvodnja medicinske opreme po meri ustanove. Pančevo, od 1985.
        </p>
      </div>

      {
        /* Mapa je ŽIVA i vidljiva odmah, ali stoji samo na početnoj —
           `/kontakt` nosi svoju uz adresu. Vidi obrazloženje uz
           `prikaziMapu` u frontmatteru. */
        prikaziMapu && (
          <div class="mapa">
            <iframe
              src={mapaSrc}
              title="Mapa — Novoseljanski put 139A, Pančevo"
              loading="lazy"
              referrerpolicy="no-referrer-when-downgrade"
            />
          </div>
        )
      }
    </div>

    <div class="mreza">
      <div class="kolona">
        <h2 class="t-labela naslov">Navigacija</h2>
        <a href="/" class="stavka">Početna</a>
        <a href="/proizvodi" class="stavka">Proizvodi</a>
        <a href="/katalog" class="stavka">Katalog</a>
        <a href="/o-nama" class="stavka">O nama</a>
        <a href="/kontakt" class="stavka">Kontakt</a>
      </div>

      <div class="kolona">
        <h2 class="t-labela naslov">Kontakt</h2>
        <a href="tel:+38113348844" class="stavka">013 348844</a>
        <address class="stavka adresa">
          Novoseljanski put 139A<br />26000 Pančevo, Srbija
        </address>
      </div>

      <div class="kolona">
        <h2 class="t-labela naslov">Radno vreme</h2>
        <p class="stavka">Ponedeljak — petak<br />07:00 — 15:00</p>
        <p class="stavka tiho">Subotom i nedeljom ne radimo</p>
      </div>

      <div class="kolona">
        <h2 class="t-labela naslov">Standardi</h2>
        <p class="stavka mono-lista">ISO 13485</p>
        <p class="stavka mono-lista">ISO 9001</p>
        <p class="stavka mono-lista">ISO 14001</p>
      </div>
    </div>

    <div class="dno">
      <span class="t-labela-sm">© {godina} SZR BSP-MGM</span>
      <span class="t-labela-sm tiho">Sva prava zadržana</span>
    </div>
  </div>
</footer>

<style>
  .podnozje {
    border-top: 1px solid var(--color-ivica);
    padding-block: clamp(3.5rem, 7vw, 6rem) 2rem;
  }

  /* REZERVA ZA DUGME „NA VRH".

     Dugme je `position: fixed` u donjem desnom uglu (46px + odmak
     16–32px). Na uskim ekranima je poslednji red podnožja završavao
     tačno ispod njega, pa je dodir na „Kontakt" ili „O nama" odlazio
     dugmetu. Izmereno na 320 i 390px, na četiri strane.

     Od 900px naviše se ne javlja: sadržaj je tada centriran i dugme stoji
     u margini. */
  @media (max-width: 899px) {
    .podnozje {
      padding-bottom: 5rem;
    }
  }

  .vrh {
    display: grid;
    gap: clamp(2rem, 4vw, 3.5rem);
    padding-bottom: clamp(2.5rem, 5vw, 4.5rem);
  }

  .vrh-tekst {
    display: grid;
    gap: 1.5rem;
    align-content: start;
  }

  .mapa {
    width: 100%;
    aspect-ratio: 16 / 9;
    max-height: 260px;
    border: 1px solid var(--color-ivica);
    background: var(--color-bela);
    overflow: hidden;
  }

  .mapa iframe {
    width: 100%;
    height: 100%;
    border: 0;
    display: block;
  }

  .znak {
    font-weight: 700;
    font-size: clamp(2.5rem, 7vw, 4.5rem);
    letter-spacing: -0.05em;
    line-height: 1;
  }

  .recenica {
    max-width: 34ch;
  }

  .mreza {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2.5rem;
    padding-block: clamp(2.5rem, 5vw, 3.5rem);
    border-top: 1px solid var(--color-ivica);
  }

  .kolona {
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
  }

  /* OPTIČKA MARGINA SE OVDE PONIŠTAVA.

     `.t-labela` nosi `margin-inline-end: -0.12em` da labela poravnata
     UDESNO ne bi vizuelno visila ulevo (razmak koji `letter-spacing` doda
     iza poslednjeg slova). Ovde je labela blok-naslov kolone, poravnat
     ULEVO — optički posao ne postoji, a negativna margina čini element
     širim od ćelije. U poslednjoj koloni to gura podnožje 1,1px preko
     desne ivice: izmereno `scrollWidth` 1441 pri `clientWidth` 1440.

     Zašto je promaklo ranijim proverama: margina je u `em`, pa zavisi od
     toga da li je font već učitan — prelivanje se pojavi tek posle zamene
     fonta. Provere skrola zato moraju da sačekaju `document.fonts.ready`. */
  .naslov {
    color: var(--color-siva);
    margin-bottom: 0.35rem;
    margin-inline-end: 0;
  }

  .stavka {
    font-size: 1.0625rem;
    line-height: 1.55;
    font-style: normal;
    transition: color 0.25s var(--ease-sala);
  }

  a.stavka:hover {
    color: var(--color-plava);
  }

  .mono-lista {
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    letter-spacing: 0.04em;
  }

  .tiho {
    color: var(--color-siva);
  }

  .dno {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem 2rem;
    justify-content: space-between;
    padding-top: 1.75rem;
    border-top: 1px solid var(--color-ivica);
    color: var(--color-siva);
  }

  @media (min-width: 640px) {
    .mreza {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1000px) {
    .vrh {
      grid-template-columns: 1fr minmax(320px, 0.62fr);
      align-items: end;
      gap: 4rem;
    }
    .vrh-tekst {
      grid-template-columns: auto 1fr;
      align-items: end;
      gap: 2.5rem;
    }
    /* Kolone po broju redova koje nose, ne jednake. */
    .mreza {
      grid-template-columns: 0.82fr 1.18fr 1.05fr 0.95fr;
      gap: 2rem;
    }
  }
</style>

