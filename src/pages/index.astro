---
import { put } from "../lib/putanja";
import Layout from "../layouts/Layout.astro";
import { Image } from "astro:assets";
import { godineRada, OSNOVANA } from "../lib/firma";
import SlikaProizvoda from "../components/SlikaProizvoda.astro";
import izblizaSlika from "../assets/proizvodi/961-5--0.webp";
import heroSlika from "../assets/hero-hala.jpg";
/**
 * PRIVREMENA PALETA — čeka stvarne uzorke od klijenta.
 *
 * RAL vrednosti su okvirne konverzije u sRGB; RAL se po definiciji određuje
 * fizičkim uzorkom, ne ekranom. Nazivi tapacirunga su generički jer ne znamo
 * dobavljača. Sve zameniti čim stigne prava paleta. Vidi CLAUDE.md, sekcija 7.
 */
const plastifikacija = [
  { id: "9016", oznaka: "RAL 9016", naziv: "Bela", hex: "#F1F0EA" },
  { id: "7035", oznaka: "RAL 7035", naziv: "Svetlo siva", hex: "#D7D7D7" },
  { id: "9006", oznaka: "RAL 9006", naziv: "Belo aluminijum", hex: "#A5A5A5" },
  { id: "7016", oznaka: "RAL 7016", naziv: "Antracit", hex: "#383E42" },
  { id: "5015", oznaka: "RAL 5015", naziv: "Nebo plava", hex: "#2271B3" },
  { id: "6018", oznaka: "RAL 6018", naziv: "Žuto zelena", hex: "#57A639" },
  { id: "1018", oznaka: "RAL 1018", naziv: "Cink žuta", hex: "#F3E03B" },
  { id: "3020", oznaka: "RAL 3020", naziv: "Crvena", hex: "#CC0605" },
];

const tapacirung = [
  { id: "siva", oznaka: "Eko-koža", naziv: "Svetlo siva", hex: "#C9CDCF" },
  { id: "antracit", oznaka: "Eko-koža", naziv: "Antracit", hex: "#3A4145" },
  { id: "plava", oznaka: "Eko-koža", naziv: "Plava", hex: "#2C5C8A" },
  { id: "tirkiz", oznaka: "Eko-koža", naziv: "Tirkiz", hex: "#2E8B84" },
  { id: "bez", oznaka: "Eko-koža", naziv: "Bež", hex: "#CBB89A" },
  { id: "bordo", oznaka: "Eko-koža", naziv: "Bordo", hex: "#7A2233" },
];

/**
 * Prikaz se prefarbava čistim CSS-om preko :has(), pa kombinacija radi i
 * bez JavaScripta. JS samo ispisuje izabrano i gradi vezu ka upitu.
 */
/* VREDNOSTI SE PROVERAVAJU PRE NEGO ŠTO UĐU U CSS.

   `cssBoje` se upisuje kroz `set:html` u `<style>`. Danas su `id` i `hex`
   tvrdo upisani nekoliko redova iznad, pa je bezbedno — ali CLAUDE.md
   (sekcija 7) kaže da se ova lista ZAMENJUJE klijentovim RAL asortimanom.

   Čim vrednosti dođu iz podataka, `hex` poput `red}#x{background:url(...)`
   izlazi iz pravila i ubacuje proizvoljan CSS. Provera je ovde da postoji
   PRE te zamene, a ne da se neko seti posle nje.

   Puca namerno, sa jasnom porukom: tiho preskakanje boje dalo bi paletu
   kojoj nedostaje nijansa, a niko ne bi znao zašto. */
const bezbednaBoja = (b: { id: string; hex: string }, gde: string) => {
  if (!/^[a-z0-9-]+$/i.test(b.id)) throw new Error(`Neispravan id boje u ${gde}: ${JSON.stringify(b.id)}`);
  if (!/^#(?:[0-9a-f]{3}|[0-9a-f]{6})$/i.test(b.hex))
    throw new Error(`Neispravan hex u ${gde} (${b.id}): ${JSON.stringify(b.hex)} — očekuje se #RGB ili #RRGGBB`);
  return b;
};

const cssBoje = [
  ...plastifikacija.map((b) => bezbednaBoja(b, "plastifikacija"))
    .map((b) => `#boje:has(#ram-${b.id}:checked) #boje-prikaz{--ram:${b.hex}}`),
  ...tapacirung.map((b) => bezbednaBoja(b, "tapacirung"))
    .map((b) => `#boje:has(#tap-${b.id}:checked) #boje-prikaz{--tap:${b.hex}}`),
].join("");

/**
 * Specifikacije za pinovanu sekciju. Svaka vrednost je iz `data/opisi.json`
 * za 961-5 — ništa nije dodato ni zaokruženo.
 */
const izbliza = [
  {
    vrednost: "4",
    labela: "elektro aktuatora",
    opis:
      "Sve funkcije na elektro pogon, sa kontrolnom jedinicom i ručnom komandom " +
      "sa ili bez ključa za zaključavanje tastature.",
  },
  {
    vrednost: "0–65°",
    labela: "leđni deo",
    opis: "Podizanje i spuštanje leđnog dela. Nožni segment 0–45°.",
  },
  {
    vrednost: "±17°",
    labela: "Trendelenburg",
    opis: "Trendelenburg −17°, antitrendelenburg 17°, uz poziciju cardio stolice.",
  },
  {
    vrednost: "240 kg",
    labela: "nosivost",
    opis: "SWL 280 kg. Oslonac na četiri rotirajuća točka sa kočnicom, prečnika 125 mm.",
  },
  {
    vrednost: "EN 60601-2-52",
    labela: "bočne ograde",
    opis:
      "Aluminijum, šest stubova. Obaraju se blagim pritiskom na ručicu, a zabravljivač " +
      "onemogućava spuštanje dok je ograda u zaštitnom položaju.",
  },
  {
    vrednost: "46–84 cm",
    labela: "visina ležišta",
    opis: "Promenljiva visina od poda, hod 38 cm. Ležeća površina 200 × 90 cm.",
  },
];

const brojke = [
  { broj: godineRada(), sufiks: "", labela: "Godina iskustva", ispod: `Osnovani ${OSNOVANA}.` },
  { broj: 2000, sufiks: " m²", labela: "Proizvodnog prostora", ispod: "Sopstveni pogon" },
  { broj: 54, sufiks: "", labela: "Proizvoda u ponudi", ispod: "12 kategorija" },
  { broj: 3, sufiks: "", labela: "ISO standarda", ispod: "13485 · 9001 · 14001" },
];

const koraci = [
  { br: "01", naziv: "Upit", tekst: "Javite nam tip opreme, dimenzije i količinu koja vam treba." },
  {
    br: "02",
    naziv: "Specifikacija",
    tekst: "Usaglašavamo dimenzije, funkcije, boje i dizajn pre nego što išta krene u rad.",
  },
  {
    br: "03",
    naziv: "Proizvodnja",
    tekst: "Izrađujemo u sopstvenom pogonu u Pančevu, od čeličnih profila, eko-kože i ABS-a.",
  },
  { br: "04", naziv: "Isporuka", tekst: "Dogovaramo rok i način isporuke prema vašem planu." },
];
---

<Layout
  naslov="Medicinska oprema po meri"
  opis="BSP proizvodi bolničke krevete, stolice za dijalizu i davanje krvi, pedijatrijsku opremu i opremu za ordinacije. Pančevo, od 1985. ISO 13485, 9001 i 14001."
  aktivna="pocetna"
>
  {/* ══════════════════════════ HERO ══════════════════════════ */}
  {/*
    „SCENA" — hero kao pozornica sa tri ravni dubine pod jednom kamerom,
    ne kao korporativni raspored 50/50.

      pozadina  →  konstrukcijska mreža (hairline rasterske linije)
      sredina   →  proizvod, izlazi van desne ivice ekrana
      prednji   →  tipografija preko cele širine i kontrole

    Ravni se razlikuju po BRZINI, ne po boji: na skrol se razmiču, na
    pokazivač se blago nagnu. Otud dubina bez ijednog efekta koji bi se
    mogao nazvati ukrasom.

    Naslov i „Sa vama više od N godina" su doslovan copy sa reference, samo
    se BROJ sada računa iz godine osnivanja umesto da stoji upisan —
    menja se samo kako stoje, ne šta pišu (vidi CLAUDE.md, 4).
  */}
  {/* `.hero` je VIŠI od ekrana, a `.hero-lepljivo` stoji. Skrol kroz tu
      razliku vozi kameru dok kompozicija miruje — bez toga se kamera pomera
      DOK slika napušta ekran, pa je niko ne vidi. Provereno snimkom: na 55%
      skrola hero je već bio prošao.

      `sticky`, ne GSAP pin: ne dira raspored i ne ume da se razmine sa
      Lenis-om (CLAUDE.md, „Sekcija Izbliza"). */}
  <section class="hero" data-hero>
    <div class="hero-lepljivo" data-hero-lepljivo>
    <div class="hero-scena" data-hero-scena>
      {/* FOTOGRAFIJA — PREKO CELOG EKRANA.

          Ovo nije slika u koloni nego POZADINA prvog ekrana. Kadar je bio u
          donjem desnom uglu i zauzimao petinu ekrana — fotografija hale tako
          nije mogla da bude ono što jeste.

          Tekst stoji PREKO nje, pa levu trećinu pokriva beli veo: fotografija
          je svetla (prosek rgb 226/227/228), ali leva strana ima udaljenu
          opremu i prozore na kojima bi crni tekst pao. Veo je BEO, ne crn —
          sajt je beo, pa se čita kao svetlo koje pada, a ne kao zatamnjenje.

          `data-hero-blenda` nosi otvaranje pri učitavanju. */}
      <div class="hero-foto" data-hero-foto aria-hidden="true">
        <div class="hero-blenda" data-hero-blenda>
          <Image
            src={heroSlika}
            alt=""
            widths={[900, 1376]}
            sizes="100vw"
            loading="eager"
            fetchpriority="high"
            decoding="sync"
            class="hero-slika"
          />
        </div>
        <span class="hero-veo" data-hero-veo></span>
      </div>

      {/* PREDNJI PLAN */}
      <div class="hero-sadrzaj">
        <p class="t-labela eyebrow" data-hero-eyebrow>
          BSP <span aria-hidden="true">·</span> Proizvodnja medicinske opreme
        </p>

        {/* Prelom u ČETIRI reda, ne tri. Mereno na 1440: sa tri reda najduži
            red je 729px i ne može da se izmakne proizvodu ni na jednoj
            širini; sa četiri je 605px, pa tekst i predmet imaju čist razmak
            svuda. Copy je nepromenjen — menja se samo gde se lomi. */}
        <h1 class="naslov" data-hero-naslov>
          <span class="red"><span data-hero-red>Naše</span></span>
          <span class="red"><span data-hero-red>iskustvo</span></span>
          <span class="red"><span data-hero-red>garantuje</span></span>
          <span class="red"><span data-hero-red>naš kvalitet.</span></span>
        </h1>

        <div class="hero-podnozje">
          <div class="hero-uvod">
            {/* Sažeto za jedan red u odnosu na raniju verziju: sa četiri
                reda uvoda scena je bila 10–22px viša od ekrana na tri širine.
                Činjenice su iste, „transfuziju" je njihov sopstveni termin. */}
            <p class="t-lead lead" data-hero-lead>
              Bolnički kreveti, stolice za dijalizu i transfuziju, pedijatrija i opremanje
              ordinacija — po vašim dimenzijama, funkcijama i bojama.
            </p>

            <div class="akcije" data-hero-akcije>
              <a href={put("/proizvodi")} class="btn btn-primary">
                Pogledajte naše proizvode
                <svg class="strelica" width="16" height="10" viewBox="0 0 16 10" fill="none" aria-hidden="true">
                  <path d="M11 1L15 5L11 9M15 5H0" stroke="currentColor" stroke-width="1.4"></path>
                </svg>
              </a>
              <a href={put("/kontakt")} class="btn btn-ghost">Zatražite ponudu</a>
            </div>
          </div>
        </div>
      </div>
    </div>

    {/* Traka činjenica zatvara scenu kao donja ivica kadra. Prva stavka je
        druga polovina njihove rečenice sa reference, u zelenoj — potvrda. */}
    <div class="shell">
      <p class="t-labela-sm hero-meta" data-hero-meta>
        <span class="hero-dokaz">Sa vama više od {godineRada()} godina</span>
        <span>Pančevo, od 1985.</span>
        <span>ISO 13485 <span aria-hidden="true">·</span> 9001 <span aria-hidden="true">·</span> 14001</span>
        <span>54 proizvoda u 12 kategorija</span>
      </p>
    </div>
    </div>
  </section>

  {/* ══════════════════════════ BROJKE ══════════════════════════ */}
  <section class="section-uz" aria-label="Firma u brojkama">
    <div class="shell">
      {/* `data-predaja`: ovu crtu NE crta `motion.ts` na ulazak u kadar nego
          režija, vezano za IZLAZAK heroja — hero na odlasku povlači prvi
          potez sledeće sekcije. Otud prelaz deluje kao namera, a ne kao dve
          animacije koje se slučajno preklope. */}
      <div class="hairline crta" data-predaja></div>
      {/* Stavke nemaju `data-otkrij`: ulaz ovog reda vozi režija, vezan za
          poziciju skrola (rezija.ts, 2). Dva tvina nad istim `y` bi se
          otimala. Bez JS-a stavke nemaju skriveno stanje, pa su odmah tu. */}
      <dl class="brojke kol-2">
        {
          brojke.map((b) => (
            <div class="brojka">
              <dd class="cifra">
                {/* Server ispisuje KONAČNU vrednost, ne nulu. Bez toga bi
                    brojka ostala na 0 i bez JS-a i pri reduced motion —
                    odbrojavanje je efekat, a broj je sadržaj. Skripta sama
                    vrati prikaz na 0 i odbroji kad krene. */}
                <span data-broj={b.broj}>{b.broj.toLocaleString("sr-RS")}</span>
                {b.sufiks}
              </dd>
              <dt class="t-labela labela">{b.labela}</dt>
              <p class="t-labela-sm ispod">{b.ispod}</p>
            </div>
          ))
        }
      </dl>
    </div>
  </section>

  {/* ══════════════════════════ BOJE I MATERIJALI ══════════════════════════ */}
  <section class="section boje" id="boje" aria-labelledby="boje-naslov">
    <style is:inline set:html={cssBoje}></style>

    <div class="shell">
      {/* Arhetip C — labela vodi. Ova sekcija služi (paleta se otvara kad je
          neko traži), pa se i najavljuje kao alat, a ne kao tema. */}
      <div class="boje-zaglavlje" data-otkrij-grupa>
        <div>
          <h2 class="t-labela zaglavlje-labela" id="boje-naslov" data-otkrij data-smer="x">
            Boje i materijali
          </h2>
        </div>

        <div class="boje-desno" data-otkrij>
          <p class="t-lead boje-uvod">
            Ram se plastificira u boji, sedišta i ležajevi se tapaciraju eko-kožom ili
            mikrofiberom. Otvorite paletu, sastavite kombinaciju i pošaljite je uz upit.
          </p>

          <button
            type="button"
            class="boje-dugme"
            aria-expanded="false"
            aria-controls="boje-panel"
            data-boje-dugme
          >
            <span class="tacke" aria-hidden="true">
              {[...plastifikacija.slice(0, 4), ...tapacirung.slice(1, 4)].map((b) => (
                <span class="tacka" style={`background:${b.hex}`} />
              ))}
            </span>
            <span class="t-labela" data-boje-tekst>Kliknite za boje</span>
            <span class="strelica-dole" aria-hidden="true">
              <svg width="12" height="8" viewBox="0 0 12 8" fill="none">
                <path d="M1 1.5L6 6.5L11 1.5" stroke="currentColor" stroke-width="1.5" />
              </svg>
            </span>
          </button>
        </div>
      </div>

      <div class="boje-panel" id="boje-panel" data-boje-panel hidden>
        <div class="boje-mreza">
          <div class="izbori">
            <fieldset class="grupa-boja">
              <legend class="t-labela legenda">Plastifikacija rama</legend>
              <ul class="uzorci">
                {
                  plastifikacija.map((b, i) => (
                    <li>
                      <input
                        type="radio"
                        name="ram"
                        id={`ram-${b.id}`}
                        class="radio"
                        checked={i === 0}
                        data-hex={b.hex}
                        data-naziv={`${b.oznaka} ${b.naziv}`}
                      />
                      <label for={`ram-${b.id}`} class="uzorak">
                        <span class="polje" style={`background:${b.hex}`} aria-hidden="true" />
                        <span class="t-mono-sm ime">{b.oznaka}</span>
                        <span class="ime-pun">{b.naziv}</span>
                      </label>
                    </li>
                  ))
                }
              </ul>
            </fieldset>

            <fieldset class="grupa-boja">
              <legend class="t-labela legenda">Tapacirung</legend>
              <ul class="uzorci">
                {
                  tapacirung.map((b, i) => (
                    <li>
                      <input
                        type="radio"
                        name="tapacirung"
                        id={`tap-${b.id}`}
                        class="radio"
                        checked={i === 0}
                        data-hex={b.hex}
                        data-naziv={b.naziv}
                      />
                      <label for={`tap-${b.id}`} class="uzorak">
                        <span class="polje" style={`background:${b.hex}`} aria-hidden="true" />
                        <span class="t-labela-sm ime">{b.naziv}</span>
                        <span class="ime-pun">{b.oznaka}</span>
                      </label>
                    </li>
                  ))
                }
              </ul>
            </fieldset>
          </div>

          <div class="prikaz">
            {/* Bazen svetla i kontaktna senka idu na SAM crtež, ne na celu
                 kolonu — inače senka padne preko teksta i dugmeta ispod. */}
            <div id="boje-prikaz" class="prikaz-ram svetlo">
              <svg
                class="krevet"
                viewBox="22 40 357 180"
                role="img"
                aria-label="Silueta bolničkog kreveta u izabranim bojama"
              >
                <g class="deo-ram">
                  <rect x="34" y="52" width="11" height="88" rx="4" />
                  <rect x="356" y="84" width="11" height="56" rx="4" />
                  <rect x="45" y="132" width="322" height="8" rx="4" />
                  <rect x="86" y="140" width="8" height="44" rx="4" />
                  <rect x="318" y="140" width="8" height="44" rx="4" />
                  <rect x="80" y="180" width="252" height="8" rx="4" />
                  <circle cx="90" cy="198" r="10" />
                  <circle cx="322" cy="198" r="10" />
                </g>
                <g class="deo-tap">
                  <rect x="62" y="110" width="96" height="22" rx="5" transform="rotate(26 158 121)" />
                  <rect x="156" y="110" width="120" height="22" rx="5" />
                  <rect x="274" y="110" width="84" height="22" rx="5" />
                </g>
                <g class="deo-ram">
                  <rect x="104" y="92" width="76" height="7" rx="3.5" />
                  <rect x="196" y="92" width="76" height="7" rx="3.5" />
                  <rect x="104" y="99" width="7" height="33" rx="3.5" />
                  <rect x="173" y="99" width="7" height="33" rx="3.5" />
                  <rect x="196" y="99" width="7" height="33" rx="3.5" />
                  <rect x="265" y="99" width="7" height="33" rx="3.5" />
                </g>
              </svg>
            </div>

            <p class="t-labela-sm izabrano" data-izabrano aria-live="polite">
              RAL 9016 Bela <span aria-hidden="true">·</span> Svetlo siva
            </p>

            <a href={put("/kontakt")} class="btn btn-ghost" data-boje-cta>
              Pošaljite ovu kombinaciju
              <svg class="strelica" width="16" height="10" viewBox="0 0 16 10" fill="none" aria-hidden="true">
                <path d="M11 1L15 5L11 9M15 5H0" stroke="currentColor" stroke-width="1.4"></path>
              </svg>
            </a>
          </div>
        </div>

        <p class="t-labela-sm napomena-boje">
          Prikaz je orijentacioni — boje na ekranu odstupaju od stvarnih uzoraka. Tačnu nijansu
          potvrđujemo po uzorku pri poručivanju.
        </p>
      </div>
    </div>
  </section>

  {/* ══════════════════════════ IZBLIZA ══════════════════════════ */}
  <section class="section-glasna izbliza" aria-labelledby="izbliza-naslov" data-izbliza>
    <div class="shell">
      {/* Arhetip A — figura vodi. Kataloška oznaka je ono po čemu se ova
          serija traži i naručuje, pa ona stoji u naslovnoj veličini, a reč
          „serija" uz nju kao labela. */}
      <div class="izbliza-zaglavlje" data-otkrij-grupa>
        <h2 class="zaglavlje-brojka istureno" id="izbliza-naslov" data-otkrij data-maska>
          <span class="figura">961</span>
          <span class="uz-figuru">
            <span class="t-labela" data-otkrij>Serija</span>
            <span class="uz-figuru-tekst t-lead">
              Bolnički krevet na elektro pogon. Ovo su vrednosti standardne izvedbe — sve se
              menja prema zahtevu ustanove.
            </span>
          </span>
        </h2>
      </div>

      <div class="izbliza-mreza">
        <div class="izbliza-vizual">
          <div class="izbliza-lepljivo">
            <div class="izbliza-kadar svetlo">
              {/* Otvor je zaseban omotač, a ne sam `.izbliza-kadar`:
                  `clip-path` seče i pseudo-elemente, pa bi na kadru odsekao
                  bazen svetla koji viri 18% van njega. Ovako predmet putuje
                  PREKO svetlosnog stola, što je i tačnije. */}
              <div class="izbliza-otvor" data-izbliza-otvor>
                <SlikaProizvoda
                  sifra="961-5"
                  naziv="Bolnički krevet elektro 961-(5)"
                  slika={izblizaSlika}
                  bezStapanja
                />
              </div>
            </div>
            <p class="t-mono-sm izbliza-brojac">
              <span data-izbliza-tekuci>01</span>
              <span aria-hidden="true">/</span>
              <span>{String(izbliza.length).padStart(2, "0")}</span>
            </p>
          </div>
        </div>

        <ol class="izbliza-stavke">
          {
            izbliza.map((x, i) => (
              <li class="izbliza-stavka" data-izbliza-stavka={i} data-aktivna={i === 0 ? "" : undefined}>
                <span class="t-mono-sm izbliza-redni">{String(i + 1).padStart(2, "0")}</span>
                <p class="izbliza-vrednost">{x.vrednost}</p>
                <p class="t-labela izbliza-labela">{x.labela}</p>
                <p class="izbliza-opis">{x.opis}</p>
              </li>
            ))
          }
        </ol>
      </div>
    </div>
  </section>

  {/* ══════════════════════════ PO MERI ══════════════════════════ */}
  <section class="section po-meri" aria-labelledby="po-meri-naslov">
    <div class="shell" data-otkrij-grupa>
      <div class="hairline crta" data-crta></div>
      {/* Arhetip B — rečenica vodi. Bez nadnaslova i bez zasebnog leada:
          sekcija nešto TVRDI, pa tvrdnja stoji u naslovnoj veličini, a
          okolnost se povlači u sivo unutar iste rečenice. */}
      <div class="pm-zaglavlje">
        <h2 class="zaglavlje-recenica" id="po-meri-naslov" data-otkrij data-maska>
          Četiri koraka do isporuke, <span class="tiho">bez posrednika — razgovarate direktno
          sa pogonom koji pravi opremu.</span>
        </h2>
      </div>

    </div>

    {/*
      Vodoravna traka. Dok se strana skroluje naniže, koraci putuju ulevo —
      čitanje procesa ima isti smer kao i sam proces.

      Bez JS-a scena nema visinu i traka ostaje obična mreža: vodoravni
      raspored se pali tek kad skripta izmeri pomak i upiše
      `data-traka-spremna`. Tako `width: max-content` nikad ne može da
      napravi vodoravno prelivanje strane.
    */}
    <div class="pm-scena" data-pm-scena>
      <div class="pm-okvir" data-pm-okvir>
        <div class="shell pm-napredak-red">
          <span class="pm-napredak" data-pm-napredak aria-hidden="true"></span>
        </div>

        {/* `data-lenis-prevent` stoji ovde zbog MOBILNOG (i rada bez JS-a),
            gde je traka stvaran vodoravni skroler. Na desktopu ga skripta
            SKIDA, jer tamo traku vozi transformacija a element prekriva ceo
            ekran — vidi `poMeri()` u `rezija.ts`. Ne pretvarati u trajan
            atribut i ne uklanjati odavde. */}
        {/* `data-lenis-prevent`: bez toga Lenis otima vodoravno prevlačenje
            unutrašnjeg skrolera i traka se ne pomera prstom. */}
        <ol class="koraci" data-pm-traka data-lenis-prevent>
          {
            koraci.map((k) => (
              <li class="korak">
                <span class="t-mono-sm korak-br">{k.br}</span>
                <h3 class="t-h3 korak-naziv">{k.naziv}</h3>
                <p class="korak-tekst">{k.tekst}</p>
              </li>
            ))
          }
        </ol>
      </div>
    </div>
  </section>

  {/* ══════════════════════════ POZIV ══════════════════════════ */}
  <section class="section poziv" aria-labelledby="poziv-naslov">
    <div class="shell" data-otkrij-grupa>
      <div class="poziv-unutra kol-3">
      {/* Bez `data-otkrij`/`data-maska`: obe kolone vozi režija (rezija.ts, 5),
          vezano za skrol i sa različitim brzinama. */}
      <h2 class="t-h2 poziv-naslov" id="poziv-naslov">
        Recite nam šta vam<br />treba u sali.
      </h2>
      <div class="poziv-desno">
        <p class="t-lead">
          Pošaljite dimenzije i funkcije koje tražite, ili nas jednostavno pozovite radnim danom
          od 7 do 15.
        </p>
        <div class="poziv-akcije">
          <a href={put("/kontakt")} class="btn btn-primary">
            Zatražite ponudu
            <svg class="strelica" width="16" height="10" viewBox="0 0 16 10" fill="none" aria-hidden="true">
              <path d="M11 1L15 5L11 9M15 5H0" stroke="currentColor" stroke-width="1.4"></path>
            </svg>
          </a>
          <a href="tel:+38113348844" class="t-mono poziv-tel">013 348844</a>
        </div>
      </div>
      </div>
    </div>
  </section>
</Layout>

<style>
  /* ───────────────── Hero: „Scena" ─────────────────
     Tri ravni dubine u jednoj mreži. Sve tri dele istu ćeliju (1/1), pa se
     slažu po Z bez apsolutnog pozicioniranja i bez računanja visina.

     `overflow-x: clip` je obavezan: proizvod NAMERNO izlazi van desne ivice,
     a bazen svetla se širi 18% van vizuala. `clip` seče samo vodoravno i ne
     pravi scroll kontejner, pa `sticky` u ostalim sekcijama nastavlja da radi. */
  .hero {
    overflow-x: clip;
    /* Dodatnih 75svh su put kojim se vozi kamera. Namerno nije 100svh —
       jedan zamah točka je dovoljan da se potisak pročita, a više bi bilo
       kočnica pred sadržajem. */
    height: 175svh;
  }

  /* Na dodiru je isti put znatno duži posao: izmereno 633px lepljivog
     skrola na telefonu, dakle nekoliko poteza prstom u kojima se samo slika
     uvećava. Kamera mora da stigne za JEDAN potez, pa se faza skraćuje na
     35svh (~295px). Režija ostaje ista, samo brža. */
  @media (max-width: 999px) {
    .hero {
      height: 135svh;
    }
  }

  .hero-lepljivo {
    position: sticky;
    top: 0;
    height: 100svh;
    display: flex;
    flex-direction: column;
    padding-bottom: clamp(1.25rem, 2.5vw, 2rem);
  }

  /* Scena nosi geometriju `.shell`-a (ista širina i isti razmak od ivice),
     pa se sve unutar nje može meriti u PROCENTIMA SADRŽAJA. Sa procentima
     ekrana ne bi išlo: preko 1560px shell se centrira, pa 52% ekrana i 52%
     sadržaja prestanu da budu isto mesto — izmereno kao razmak od 1px
     između naslova i proizvoda na 1920. */
  .hero-scena {
    position: relative;
    flex: 1;
    width: 100%;
    max-width: 1560px;
    margin-inline: auto;
    padding-inline: clamp(1.25rem, 5vw, 5rem);
    display: grid;
    /* `svh`, ne `vh`: na telefonu `vh` računa i traku pregledača, pa hero
       ispadne viši od ekrana i podnožje se ne vidi. */
    /* Zaglavlje je fiksno — sadržaj kreće ispod njega. */
    /* I gornji razmak mora da zna za visinu ekrana: na 1280×800 je `10vw`
       udarao u kapicu od 8rem dok je prozor ostao nizak, pa je scena
       ispadala 17px viša od ekrana. */
    padding-top: clamp(5.5rem, min(10vw, 13svh), 8rem);
  }

  /* Fotografija je NAMERNO izuzeta: ona nije ćelija u mreži nego sloj ispod
     svega. Dok je bila grid item, `inset: 0` se računao od ĆELIJE, pa je
     slika stajala unutar razmaka scene — izmereno kao 72,117 / 1368×783
     umesto pune scene. */
  .hero-scena > *:not(.hero-foto) {
    grid-area: 1 / 1;
  }

  /* Raster (četiri hairline linije) je UKLONJEN sa heroja: pozadinska ravan
     je sada sama fotografija. Preko fotografije bi te linije bile vidljive
     samo na belom velu levo, dakle izgledale bi kao greška, a ne kao raster. */

  /* ── FOTOGRAFIJA PREKO CELOG EKRANA ──────────────────────────────────
     Sloj ispod sadržaja, preko cele scene. Ne učestvuje u mreži — zato
     `position: absolute`, a ne `grid-area`. */
  .hero-foto {
    position: absolute;
    /* Scena je centrirana i široka najviše 1560px. Bez ovog izlaska bi na
       1920px ekranu sa svake strane ostalo po 180px bele — a slika treba da
       ide od ivice do ivice. `top`/`bottom` idu na −1px zbog zaokruživanja
       pri skalovima različitim od 100%. */
    top: -1px;
    bottom: -1px;
    left: calc(50% - 50vw);
    width: 100vw;
    z-index: 0;
    pointer-events: none;
    overflow: clip;
  }

  /* Blenda. Pri učitavanju je vodoravna traka na sredini i otvara se na pun
     ekran — jedan potez, jedan udarac. Početno stanje stoji u CSS-u da bi
     bilo tačno i pre nego što skript krene. */
  .hero-blenda {
    position: absolute;
    inset: 0;
    clip-path: inset(44% 0% 44% 0%);
  }

  :global(.no-js) .hero-blenda,
  :global(.motion-off) .hero-blenda {
    clip-path: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-blenda {
      clip-path: none !important;
    }
  }

  .hero-slika {
    width: 100%;
    height: 100%;
    object-fit: cover;
    /* Krevet je u desnoj polovini fotografije (izmereno: težište tamne mase
       75% x, 62% y). Kadriranje se drži njega, pa se pri sečenju gubi levi
       prazan pod, a ne predmet. */
    object-position: 58% 62%;
    /* `transform-origin` MORA biti ovde, ne u tvinu.

       Dok je stajao samo u skrol tvinu, prelazio je sa podrazumevanih
       `50% 50%` na `58% 62%` tek kad taj tvin prvi put iscrta — a pri
       `scale 1.07` to pomeri sliku za ~11px UDESNO. To je bio „skok pri
       prvom skrolu": nije bilo loše fiksiranje nego promena tačke oko koje
       se skalira, usred skaliranja. */
    /* Tačka skaliranja je NA KREVETU (izmeren na ~73% x, 65% y ekrana).
       Zato pri potisku kamere pozadina beži od njega, a on stoji — to je
       razlika između kamere koja prilazi i zuma. */
    transform-origin: 73% 65%;
  }

  /* Beli veo. Leva trećina fotografije nosi udaljenu opremu i prozore —
     crni tekst preko toga pada. Veo je u boji same strane, pa se čita kao
     svetlo koje pada s leva, a ne kao ploča ispod teksta.
     Jačina je podešena po izmerenom kontrastu, ne po oku. */
  /* SVETLO, NE PRELIV.

     Prva verzija je bila linearni preliv pod 100° i videla se kao dijagonalna
     ivica — leva trećina je čitana kao izbledela fotografija, a ne kao ista
     fotografija. Izmereno je i da je bila mnogo jača nego što treba: naslov
     je imao 5,1–15,6:1 pri pragu od 3:1, uvod 15,8 pri pragu 4,5.

     Sada je RADIJALNI izvor svetla iza leve ivice ekrana. Radijalni pad nema
     pravac, pa nema ni vidljive granice — čita se kao svetlo koje ulazi kroz
     prozor hale, a ne kao ploča preko slike. Jačina je spuštena na meru koja
     tek drži kontrast, ne preko toga.

     `--veo-x` pomera izvor svetla: režija ga na skrol odvodi ulevo, pa se
     mirna zona povlači i fotografija preuzima ceo ekran. To je „prozor
     postaje prostorija" — bez okvira, jer okvira više nema. */
  .hero-veo {
    position: absolute;
    inset: 0;
    background: radial-gradient(
      ellipse 96% 140% at var(--veo-x, -6%) 48%,
      var(--color-sala) 0%,
      color-mix(in oklab, var(--color-sala) 90%, transparent) 34%,
      color-mix(in oklab, var(--color-sala) 58%, transparent) 56%,
      transparent 82%
    );
  }

  /* ── Prednja ravan: tipografija i kontrole ────────────────────────── */
  .hero-sadrzaj {
    position: relative;
    z-index: 2;
    display: grid;
    grid-template-rows: auto auto 1fr;
    gap: clamp(1.25rem, 2.2vw, 1.75rem);
    padding-bottom: clamp(0.75rem, 1.5vw, 1.25rem);
    /* Sadržaj ne sme da guta klikove na proizvod ispod — ali sam proizvod
       nije klikabilan, pa ovde ostaje normalno ponašanje. */
  }

  .eyebrow {
    color: var(--color-siva);
    margin: 0;
  }

  /* Tipografija je KRUPNIJA nego pre (bilo 8vw / 7.5rem). Veličina je
     ograničena i visinom ekrana (`svh`), ne samo širinom — inače na niskom
     prozoru naslov pojede podnožje heroja. */
  .naslov {
    margin: 0;
    font-family: var(--font-display, inherit);
    font-weight: 600;
    /* Veličina je ograničena i VISINOM ekrana, ne samo širinom. Bez `svh`
       grane naslov na niskom prozoru pojede podnožje heroja — izmereno kao
       scena od 1031px u prozoru od 900px. */
    /* Donja granica je 13vw, ne 2.5rem: na 390px je naslov ispadao 40px, a
       to na primarnoj izjavi nije izjava. Sada ~51px, uz zadržan uslov da
       hero stane u jedan ekran (mereno). */
    font-size: clamp(3.2rem, min(13vw, 12svh), 8.5rem);
    line-height: 0.92;
    letter-spacing: -0.038em;
    text-wrap: balance;
    max-width: 16ch;
  }

  .red {
    display: block;
    overflow: hidden;
    padding-bottom: 0.06em;
  }

  .red > span {
    display: block;
  }

  .hero-podnozje {
    align-self: end;
  }

  .hero-uvod {
    display: grid;
    gap: clamp(1rem, 2vw, 1.5rem);
    max-width: 50ch;
  }

  .lead {
    margin: 0;
  }

  .akcije {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  /* ── Donja ivica kadra ────────────────────────────────────────────── */
  /* Hairline je donja ivica fotografije: scena se završava tačno tamo gde
     ova crta počinje. Zato se ne crta borderom nego pseudo-elementom koji
     režija izvlači sleva (`--crta` 0 → 1) dok hero odlazi — fotografija se
     sliva u liniju umesto da se ugasi. */
  .hero-meta {
    position: relative;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 2.5rem;
    margin: 0;
    padding-top: 1.25rem;
    color: var(--color-siva);
  }

  .hero-meta::before {
    content: "";
    position: absolute;
    inset-block-start: 0;
    inset-inline: 0;
    height: 1px;
    background: var(--color-ivica);
    transform-origin: left center;
  }

  /* Zelena je potvrda — ovde potvrđuje staž. */
  .hero-dokaz {
    color: var(--color-zelena);
  }

  /* Na niskom telefonu se razmak steže, a tipografija NE smanjuje: naslov je
     primarna izjava strane i on je poslednje što treba da ustupi prostor.
     Mereno pre izmene: 13 mini +9px, Galaxy S22 +12px preko ekrana — višak
     je bio u razmaku, ne u slovima. */
  @media (max-width: 860px) and (max-height: 830px) {
    .hero-scena {
      padding-top: clamp(4.5rem, 11svh, 6.5rem);
    }

    .hero-sadrzaj {
      gap: clamp(0.9rem, 1.6vh, 1.4rem);
      padding-bottom: 0.5rem;
    }

    .hero-uvod {
      gap: 0.9rem;
    }
  }

  /* ── Raspored po širinama ─────────────────────────────────────────── */
  @media (max-width: 999px) {
    /* Na uskom ekranu proizvod ne može da izađe iz kadra a da ne pojede
       tekst: vraća se u tok, ispod sadržaja. */
    .hero-scena {
      min-height: 0;
      perspective: none;
      grid-template-rows: auto auto;
      gap: clamp(2rem, 5vw, 3rem);
    }
    .hero-scena > * {
      grid-area: auto;
    }
    /* Na uskom ekranu fotografija ostaje preko celog ekrana, ali se veo
       okreće: odozdo naviše umesto s leva, jer tekst tu stoji ISPOD naslova
       preko cele širine, a ne u levoj koloni. */
    .hero-veo {
      background: radial-gradient(
        ellipse 140% 78% at 50% 112%,
        var(--color-sala) 0%,
        color-mix(in oklab, var(--color-sala) 84%, transparent) 38%,
        color-mix(in oklab, var(--color-sala) 40%, transparent) 62%,
        transparent 84%
      );
    }

    .hero-sadrzaj {
      grid-template-rows: auto auto auto;
    }
  }

  /* Bez JS-a nema režije koja bi je iscrtala — crta prosto stoji. */
  :global(.no-js) [data-predaja],
  :global(.motion-off) [data-predaja] {
    transform: none;
  }

  /* Arhetip A: naziv i objašnjenje stoje jedno ispod drugog uz figuru. */
  .uz-figuru {
    display: grid;
    gap: 0.5rem;
  }

  .uz-figuru-tekst {
    display: block;
    max-width: 46ch;
  }

  /* ───────────────── Brojke ───────────────── */
  .crta {
    transform-origin: left center;
  }

  /* `margin-block`: skraćenica `margin` gasi klase polja — vidi global.css. */
  .brojke {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: clamp(2rem, 4vw, 3rem);
    margin-block: 0;
    padding-top: clamp(1.75rem, 3vw, 2.5rem);
  }

  .brojka {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .cifra {
    font-family: var(--font-display);
    font-optical-sizing: auto;
    margin: 0;
    /* Broj i jedinica ostaju u istom redu — "2.000" i "m²" razdvojeni
       prelomom su tipografska greška, ne samo ružan prizor. */
    white-space: nowrap;
    font-size: clamp(2.75rem, 5vw, 4.25rem);
    font-weight: 600;
    letter-spacing: -0.04em;
    line-height: 1;
    font-variant-numeric: tabular-nums;
  }

  .labela {
    color: var(--color-celik);
  }

  .ispod {
    color: var(--color-siva);
    margin: 0;
  }

  .nadnaslov {
    color: var(--color-siva);
    margin-bottom: 1rem;
  }

  /* ───────────────── Boje i materijali ───────────────── */
  .boje-zaglavlje {
    display: grid;
    gap: 1.25rem;
    margin-bottom: clamp(2.5rem, 5vw, 4rem);
  }

  .boje-uvod {
    max-width: 48ch;
    margin: 0;
  }

  .boje-desno {
    display: flex;
    flex-direction: column;
    align-items: start;
    gap: 1.5rem;
  }

  /* Okidač palete. Tačke unapred kažu o čemu se radi, pa dugme ne mora. */
  .boje-dugme {
    display: inline-flex;
    align-items: center;
    gap: 0.9rem;
    min-height: 48px;
    padding: 0 1.25rem;
    background: var(--color-bela);
    border: 1px solid var(--color-ivica);
    color: var(--color-celik);
    transition:
      border-color 0.45s var(--ease-sala),
      color 0.45s var(--ease-sala);
  }

  .boje-dugme:hover {
    border-color: var(--color-plava);
    color: var(--color-plava);
  }

  .boje-dugme[aria-expanded="true"] {
    color: var(--color-plava);
    border-color: var(--color-plava);
  }

  .tacke {
    display: flex;
  }

  .tacka {
    display: block;
    width: 13px;
    height: 13px;
    border-radius: 50%;
    border: 1px solid color-mix(in oklab, var(--color-celik) 14%, transparent);
    margin-right: -4px;
  }

  .tacka:last-child {
    margin-right: 0;
  }

  .strelica-dole {
    display: flex;
    color: var(--color-siva);
    transition: transform 0.55s var(--ease-sala);
  }

  .boje-dugme[aria-expanded="true"] .strelica-dole {
    transform: rotate(180deg);
    color: var(--color-plava);
  }

  .boje-panel {
    overflow: hidden;
  }

  .boje-mreza {
    display: grid;
    gap: clamp(2.5rem, 5vw, 4.5rem);
    align-items: start;
    padding-top: clamp(2rem, 4vw, 3rem);
  }

  .izbori {
    display: flex;
    flex-direction: column;
    gap: clamp(2rem, 3.5vw, 2.75rem);
    /* Okvir izabrane boje izlazi 2px van uzorka, a fokus prsten još 3px.
       Bez ovog uvlačenja ih `overflow` panela seče na najlevljem uzorku. */
    padding-left: 8px;
  }

  .grupa-boja {
    margin: 0;
    padding: 0;
    border: 0;
  }

  .legenda {
    color: var(--color-siva);
    padding: 0 0 1rem;
  }

  /* Uzorci su fiksne veličine i lome se u red, kao na paleti boja.
     Ranije su bili 99px u auto-fill mreži: u red je stajalo 6, pa je od
     osam nijansi drugi red imao samo dva komada i veliku rupu desno. */
  .uzorci {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 1.5rem 1.25rem;
  }

  .uzorci > li {
    width: 68px;
  }

  /* Radio ostaje u DOM-u zbog tastature i čitača ekrana, samo se ne vidi. */
  .radio {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
    border: 0;
  }

  .uzorak {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    cursor: pointer;
  }

  .polje {
    display: block;
    aspect-ratio: 1;
    width: 100%;
    border: 1px solid var(--color-ivica);
    box-shadow: inset 0 0 0 0 var(--color-plava);
    transition:
      box-shadow 0.45s var(--ease-sala),
      transform 0.45s var(--ease-sala);
  }

  .uzorak:hover .polje {
    transform: translateY(-2px);
  }

  .radio:checked + .uzorak .polje {
    box-shadow:
      inset 0 0 0 3px var(--color-sala),
      0 0 0 2px var(--color-plava);
  }

  .radio:focus-visible + .uzorak .polje {
    outline: 2px solid var(--color-plava);
    outline-offset: 3px;
  }

  .ime {
    color: var(--color-celik);
    line-height: 1.3;
  }

  .ime-pun {
    color: var(--color-siva);
    font-size: 0.75rem;
    line-height: 1.3;
  }

  .radio:checked + .uzorak .ime {
    color: var(--color-plava);
  }

  /* Prikaz */
  .prikaz {
    display: flex;
    flex-direction: column;
    align-items: start;
    gap: 1.75rem;
  }

  .prikaz-ram {
    --ram: #f1f0ea;
    --tap: #c9cdcf;
    width: 100%;
    /* Prostor za bazen svetla i kontaktnu senku, da ne naliježu na tekst. */
    padding-block: clamp(1.25rem, 3vw, 2.25rem);
  }

  .krevet {
    width: 100%;
    height: auto;
  }

  .deo-ram rect,
  .deo-ram circle {
    fill: var(--ram);
    stroke: color-mix(in oklab, var(--color-celik) 22%, transparent);
    stroke-width: 1;
    transition: fill 0.45s var(--ease-sala);
  }

  .deo-tap rect {
    fill: var(--tap);
    stroke: color-mix(in oklab, var(--color-celik) 18%, transparent);
    stroke-width: 1;
    transition: fill 0.45s var(--ease-sala);
  }

  .izabrano {
    color: var(--color-celik);
    padding-top: 1rem;
    border-top: 1px solid var(--color-ivica);
    width: 100%;
  }

  .napomena-boje {
    color: var(--color-siva);
    max-width: 62ch;
    margin: clamp(2rem, 4vw, 3rem) 0 0;
    padding-top: 1.25rem;
    border-top: 1px solid var(--color-ivica);
  }

  /* ───────────────── Izbliza ───────────────── */
  /* ── TAMNO POGLAVLJE ──────────────────────────────────────────────────
     Izmereno pre izmene: svetlina ekrana kroz ceo sajt 0,85–0,88, a raspon
     na `/o-nama` svega 0,006 kroz 7.035px. Sedam hiljada piksela iste
     svetline čini da se sve sekcije pamte kao jedna.

     Ovo je JEDINO tamno mesto na sajtu i nije dekoracija. Potpisni element
     pravca „Sala" je SVETLOSNI STO — na beloj podlozi to je samo meka
     senka, a na tamnoj proizvod prestaje da bude slika na podlozi i postaje
     izvor svetla. Fotografija je providan PNG (provereno: alfa min 0,
     `isOpaque: false`), pa na tamnom nema belog pravougaonika.

     Zato baš ova sekcija: ona jedina POKAZUJE proizvod izbliza. Tamno
     poglavlje mora da bude tamo gde je predmet, ne pred podnožjem kao
     tonski ukras.

     Ivice se ne prelivaju gradijentom — sekcija počinje i završava rezom,
     kao promena kadra. Preliv bi tvrdio da je to isti prostor. */
  .izbliza {
    overflow-x: clip;
    background: var(--color-celik);
    color: var(--color-sala);
    /* Bazen se pretače: na čeliku jezgro je prigušeno svetlo, a ne bela —
       čista bela bi bila reflektor, ne sto. Kontaktna senka ide u crno, jer
       postojeća (čelik 20%) na čeliku ne postoji. */
    --svetlo-jezgro: rgba(255, 255, 255, 0.2);
    --svetlo-rub: rgba(150, 190, 205, 0.09);
    --svetlo-senka: rgba(0, 0, 0, 0.55);
    --svetlo-jacina: 1;
  }

  /* Na tamnom se hairline mora podići — `--color-ivica` (#E3E8EA) je
     mišljena za belu podlogu i na čeliku bi bila skoro bela linija. */
  .izbliza .izbliza-stavka {
    border-bottom-color: rgba(244, 246, 247, 0.16);
  }

  .izbliza .zaglavlje-brojka .figura,
  .izbliza .izbliza-vrednost {
    color: var(--color-sala);
  }

  .izbliza .uz-figuru,
  .izbliza .uz-figuru-tekst,
  .izbliza .izbliza-opis,
  .izbliza .izbliza-brojac {
    color: rgba(244, 246, 247, 0.62);
  }

  .izbliza .izbliza-labela {
    color: var(--color-sala);
  }

  /* Zelena sa bele podloge (#2F6F5E) na čeliku daje 2,1:1 i pada.
     Ista uloga, svetlija nijansa: potvrda ostaje zelena, ali čitljiva. */
  .izbliza .izbliza-brojac [data-izbliza-tekuci],
  .izbliza .izbliza-stavka[data-aktivna] .izbliza-redni,
  .izbliza .t-labela {
    color: #6fc2a8;
  }

  .izbliza .izbliza-redni {
    color: rgba(244, 246, 247, 0.5);
  }

  .izbliza-zaglavlje {
    display: grid;
    gap: 1.25rem;
    margin-bottom: clamp(2.5rem, 5vw, 4rem);
  }

  /* BEZ `align-items: start`: kolona sa slikom mora da se rastegne na visinu
     reda, inače `sticky` nema kroz šta da putuje i slika se nikad ne zakači. */
  .izbliza-mreza {
    display: grid;
    gap: clamp(2rem, 4vw, 4rem);
  }

  .izbliza-vizual {
    height: 100%;
  }

  /* Slika stoji na mestu dok specifikacije prolaze pored nje. CSS `sticky`,
     ne GSAP pin: ne dira raspored, ne traži preračunavanje i ne ume da se
     razmine sa Lenis-om. */
  /* Lepljenje tek od 1000px. U jednoj koloni bi slika zauzela pola ekrana
     dok tekst prolazi ispod nje. */
  .izbliza-lepljivo {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .izbliza-kadar {
    position: relative;
    padding-block: clamp(0.5rem, 1.5vw, 1rem);
  }

  /* `will-change` je NAMERNO uklonjen odavde i sa heroja.

     Bilo je šest trajnih promovisanih slojeva, od kojih dva preko celog
     ekrana. `will-change` nije besplatan: drži sloj u memoriji GPU-a za
     ceo život strane, i kad se nagomila postaje uzrok podrhtavanja koje
     je trebalo da spreči. Transform i clip-path se i bez njega izvode na
     kompozitoru. */

  /* `pathLength="1"` normalizuje sve putanje na istu dužinu, pa jedan par
     vrednosti dasharray/dashoffset iscrtava svaku od njih. */
  .izbliza-brojac {
    display: flex;
    gap: 0.4rem;
    color: var(--color-siva);
    font-variant-numeric: tabular-nums;
  }

  .izbliza-brojac [data-izbliza-tekuci] {
    color: var(--color-zelena);
  }

  .izbliza-stavke {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  /* Prigušena dok nije na redu — zato NEMA `data-otkrij`: prelaz iz
     prigušenog u istaknuto JESTE otkrivanje. */
  .izbliza-stavka {
    display: grid;
    gap: 0.35rem;
    padding-block: clamp(2.5rem, 6vw, 4.5rem);
    border-bottom: 1px solid var(--color-ivica);
    opacity: 0.32;
    transform: translateY(10px);
    transition:
      opacity 0.55s var(--ease-sala),
      transform 0.55s var(--ease-sala);
  }

  .izbliza-stavka[data-aktivna] {
    opacity: 1;
    transform: none;
  }

  .izbliza-redni {
    color: var(--color-siva);
    transition: color 0.55s var(--ease-sala);
  }

  .izbliza-stavka[data-aktivna] .izbliza-redni {
    color: var(--color-zelena);
  }

  .izbliza-vrednost {
    font-family: var(--font-display);
    font-optical-sizing: auto;
    margin: 0;
    font-size: clamp(2rem, 4.5vw, 3.25rem);
    font-weight: 600;
    letter-spacing: -0.04em;
    line-height: 1;
    font-variant-numeric: tabular-nums;
  }

  .izbliza-labela {
    margin: 0;
    color: var(--color-celik);
  }

  .izbliza-opis {
    margin: 0.5rem 0 0;
    max-width: 46ch;
    color: var(--color-siva);
    font-size: 1.0625rem;
    line-height: 1.6;
  }

  :global(.no-js) .izbliza-stavka,
  :global(.motion-off) .izbliza-stavka {
    opacity: 1;
    transform: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .izbliza-stavka {
      opacity: 1 !important;
      transform: none !important;
    }
  }

  /* ───────────────── Po meri ───────────────── */
  /* Razmak od hairline crte iznad — ne ponavljaj padding sekcije. */
  .pm-zaglavlje {
    display: grid;
    gap: 1.25rem;
    padding-top: clamp(1.5rem, 2.5vw, 2rem);
    margin-bottom: clamp(2.5rem, 4vw, 3.5rem);
  }

  /* ── Vodoravna traka koraka ───────────────────────────────────────────
     Podrazumevano je obična mreža — to je i stanje bez JS-a. Vodoravni
     raspored pali skripta tek pošto izmeri koliko traka viri. */
  .pm-scena {
    position: relative;
    margin-top: clamp(2.5rem, 5vw, 4rem);
  }

  .koraci {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 2.5rem;
  }

  .korak {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--color-ivica);
  }

  .pm-napredak-red {
    display: none;
  }

  /* ── NA DODIR: traka se prevlači prstom ───────────────────────────────
     Ispod 860px skrol-vožnja je isključena (vidi rezija.ts). Ranije je tu
     ostajala obična mreža — mobilni je time gubio potez koji desktop ima.

     Prevlačenje prstom nije siromašnija zamena nego BOLJI potez na dodiru:
     nativno je, bez JS-a, bez skrol-otimanja, i `scroll-snap` zaustavlja
     tačno na koraku. Desktop dobija vožnju skrolom, dodir dobija prevlačenje
     — dva različita ulaza, isti sadržaj. */
  @media (max-width: 859px) {
    .koraci {
      display: flex;
      gap: 1rem;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      /* Prvi i poslednji korak se poravnavaju sa ivicom sadržaja. */
      scroll-padding-inline: 0;
      padding-bottom: 0.75rem;
      scrollbar-width: none;
      /* Lenis mora da pusti ovaj skroler — bez toga otima prevlačenje. */
      overscroll-behavior-x: contain;
    }

    .koraci::-webkit-scrollbar {
      display: none;
    }

    .korak {
      flex: none;
      width: min(78vw, 20rem);
      scroll-snap-align: start;
    }
  }

  /* Traka je aktivna: okvir se lepi, a koraci stoje u jednom redu. */
  .pm-scena[data-traka-spremna] .pm-okvir {
    position: sticky;
    top: 24vh;
    /* `clip`, ne `hidden`: ne pravi scroll kontejner, pa ne otima skrol
       Lenis-u i ne seče bazen svetla susednih sekcija. */
    overflow-x: clip;
  }

  .pm-scena[data-traka-spremna] .koraci {
    display: flex;
    width: max-content;
    gap: clamp(2rem, 4vw, 4rem);
    /* Prvi korak počinje tačno na levoj ivici sadržaja, ispod naslova.
       `.shell` ima i `max-width` i `margin: auto`, pa se ta ivica ne može
       napisati u CSS-u — skripta je izmeri i upiše u `--pm-uvod`. */
    padding-inline-start: var(--pm-uvod, 1.25rem);
    padding-inline-end: clamp(1.25rem, 5vw, 5rem);
  }

  /* Korak je u traci ploča, ne stubac u mreži: širi je i sa više vazduha.
     Uz to traka tek tako ima stvaran put — na 26vw je izmereno svega 213px
     pomaka, što se čitalo kao podrhtavanje, a ne kao putovanje. */
  .pm-scena[data-traka-spremna] .korak {
    flex: none;
    width: clamp(18rem, 34vw, 30rem);
    gap: 0.9rem;
    padding-top: 1.75rem;
  }

  .pm-scena[data-traka-spremna] .korak-tekst {
    font-size: 1.0625rem;
    max-width: 34ch;
  }

  .pm-scena[data-traka-spremna] .pm-napredak-red {
    display: block;
    margin-bottom: clamp(1.5rem, 3vw, 2.5rem);
  }

  .pm-napredak {
    display: block;
    height: 1px;
    background: var(--color-ivica);
    position: relative;
  }

  /* Zelena je mera — ovde meri koliko je procesa pređeno. */
  .pm-napredak::after {
    content: "";
    position: absolute;
    inset: 0;
    background: var(--color-zelena);
    transform: scaleX(var(--pm-progres, 0));
    transform-origin: left center;
  }

  /* `align-self: start` nije kozmetika: `.korak` je flex kolona, pa bi se
     span razvukao preko cele širine, a optička korekcija `.t-mono-sm`
     (`margin-inline-end: -0.14em`) bi mu tada gurnula desnu ivicu 1,5px van
     ekrana. Izmereno kao 2px vodoravnog prelivanja na 390px. */
  .korak-br {
    color: var(--color-zelena);
    align-self: start;
  }

  .korak-naziv {
    margin: 0;
  }

  .korak-tekst {
    margin: 0;
    color: var(--color-siva);
    font-size: 1.0625rem;
    line-height: 1.6;
  }

  /* Traka je uži isečak izvorne slike (1376x768). Na telefonu se drži
     odnosom, da isečak ostane blag; na širokim ekranima ide fiksna visina
     pa se čita kao pojas, a ne kao još jedna velika fotografija. */
  /* ───────────────── Poziv ───────────────── */
  .poziv {
    border-top: 1px solid var(--color-ivica);
  }

  .poziv-unutra {
    display: grid;
    gap: clamp(2rem, 4vw, 4rem);
  }

  .poziv-naslov {
    margin: 0;
  }

  .poziv-desno {
    display: flex;
    flex-direction: column;
    gap: 1.75rem;
    max-width: 44ch;
  }

  .poziv-akcije {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1.5rem;
  }

  .poziv-tel {
    color: var(--color-plava);
  }

  /* ───────────────── Breakpointi ───────────────── */
  @media (min-width: 720px) {
    /* Ne `repeat(4, 1fr)`: „2.000 m²" i „Proizvodnog prostora" traže više
       prostora nego „3" i „ISO standarda". Jednake kolone bi terale duži
       tekst da se prelama dok kraći pluta u praznini. */
    .brojke {
      grid-template-columns: 0.92fr 1.32fr 1fr 0.76fr;
    }
    .pm-scena:not([data-traka-spremna]) .koraci {
      grid-template-columns: repeat(2, 1fr);
      gap: 2.5rem 3rem;
    }
  }

  @media (min-width: 1200px) {
    .boje-mreza {
      grid-template-columns: 1.3fr 0.7fr;
    }
    .prikaz {
      position: sticky;
      top: 128px;
    }
  }

  @media (min-width: 1000px) {
    .izbliza-mreza {
      grid-template-columns: 0.9fr 1.1fr;
      gap: clamp(3rem, 6vw, 6rem);
    }
    .izbliza-lepljivo {
      position: sticky;
      top: 18vh;
    }
    /* Ranije je OVO jedno pravilo davalo trima sekcijama identično
       zaglavlje `1fr 1fr`. Otud utisak da su zamenljive. Sada svaka ima
       svoj arhetip, pa joj treba i svoj raspored:
         izbliza  → figura i tekst su u flex-u, mreža im ne treba
         po-meri  → jedna rečenica, mreža joj ne treba
         boje     → dve stvari, ali NEJEDNAKE težine (labela je uska) */
    .boje-zaglavlje {
      grid-template-columns: 0.62fr 1.38fr;
      align-items: end;
      gap: clamp(2rem, 5vw, 4rem);
    }
    .pm-scena:not([data-traka-spremna]) .koraci {
      grid-template-columns: repeat(4, 1fr);
    }
    .poziv-unutra {
      grid-template-columns: 1.18fr 0.82fr;
      align-items: start;
    }
  }
</style>

<script>
  import gsap from "gsap";
  import { naSvakojStrani } from "../scripts/zivot";

  /* Telo strane se menja bez novog učitavanja (View Transitions), pa se
     ovo mora pokrenuti iznova na svakom prikazu. Vraćeni čistač gasi
     posmatrača specifikacija — on nadživljava telo strane. */
  naSvakojStrani(() => {
    const posmatraci: IntersectionObserver[] = [];


    /**
     * Pinovane specifikacije: slika stoji (CSS `sticky`), a stavke se smenjuju.
     * Aktivnu bira IntersectionObserver sa uskim pojasom oko sredine ekrana —
     * uvek je tačno jedna na redu.
     */
    {
      const stavke = [...document.querySelectorAll<HTMLElement>("[data-izbliza-stavka]")];
      const brojac = document.querySelector<HTMLElement>("[data-izbliza-tekuci]");

      if (stavke.length) {
        let tekuca = 0;

        const postavi = (i: number) => {
          if (i === tekuca) return;
          stavke[tekuca]?.removeAttribute("data-aktivna");
          stavke[i]?.setAttribute("data-aktivna", "");
          tekuca = i;
          if (brojac) brojac.textContent = String(i + 1).padStart(2, "0");
        };

        const posmatrac = new IntersectionObserver(
          (unosi) => {
            const usla = unosi
              .filter((u) => u.isIntersecting)
              .sort((a, b) => a.boundingClientRect.top - b.boundingClientRect.top)[0];
            if (!usla) return;
            const i = Number((usla.target as HTMLElement).dataset.izblizaStavka);
            if (Number.isFinite(i)) postavi(i);
          },
          // Uzak pojas oko sredine: stavka je „na redu" dok prolazi kroz njega.
          { rootMargin: "-45% 0px -45% 0px", threshold: 0 },
        );

        stavke.forEach((s) => posmatrac.observe(s));
      posmatraci.push(posmatrac);
      }
    }

    /**
     * Paleta stoji sklopljena — sekcija je time mirnija, a boje se otvaraju
     * tek kad ih neko traži. Visina se animira, pa panel ne iskače.
     */
    {
      const dugme = document.querySelector<HTMLButtonElement>("[data-boje-dugme]");
      const panel = document.querySelector<HTMLElement>("[data-boje-panel]");
      const tekst = document.querySelector<HTMLElement>("[data-boje-tekst]");
      const tiho = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

      if (dugme && panel) {
        dugme.addEventListener("click", () => {
          const otvoren = dugme.getAttribute("aria-expanded") === "true";
          dugme.setAttribute("aria-expanded", String(!otvoren));
          if (tekst) tekst.textContent = otvoren ? "Kliknite za boje" : "Zatvorite paletu";

          if (otvoren) {
            panel.style.overflow = "hidden";
            if (tiho) {
              panel.hidden = true;
              return;
            }
            gsap.to(panel, {
              height: 0,
              opacity: 0,
              duration: 0.38,
              ease: "power2.in",
              onComplete: () => {
                panel.hidden = true;
                panel.style.height = "";
                panel.style.opacity = "";
              },
            });
          } else {
            panel.hidden = false;
            if (tiho) {
              panel.style.overflow = "visible";
              return;
            }
            gsap.fromTo(
              panel,
              { height: 0, opacity: 0 },
              {
                height: panel.scrollHeight,
                opacity: 1,
                duration: 0.55,
                ease: "power2.out",
                onComplete: () => {
                  panel.style.height = "auto";
                  // Sečenje je potrebno samo dok visina putuje. Posle ga gasimo
                  // da okvir izabrane boje i lepljivi prikaz ne budu odsečeni.
                  panel.style.overflow = "visible";
                },
              },
            );
          }
        });
      }
    }

    /**
     * CSS preko :has() već farba prikaz, pa kombinacija radi i bez JS-a.
     * Ovde se samo ispisuje izbor i gradi veza ka upitu sa unetom kombinacijom.
     */
    const izabrano = document.querySelector<HTMLElement>("[data-izabrano]");
    const cta = document.querySelector<HTMLAnchorElement>("[data-boje-cta]");
    const prikaz = document.getElementById("boje-prikaz");

    if (izabrano && cta && prikaz) {
      const cid = (ime: string) =>
        document.querySelector<HTMLInputElement>(`input[name="${ime}"]:checked`);

      const osvezi = () => {
        const ram = cid("ram");
        const tap = cid("tapacirung");
        if (!ram || !tap) return;

        const ramNaziv = ram.dataset.naziv ?? "";
        const tapNaziv = tap.dataset.naziv ?? "";

        izabrano.textContent = `${ramNaziv} · ${tapNaziv}`;

        // Rezervni put ako pregledač nema :has()
        prikaz.style.setProperty("--ram", ram.dataset.hex ?? "");
        prikaz.style.setProperty("--tap", tap.dataset.hex ?? "");

        const upit = new URLSearchParams({
          ram: ramNaziv,
          tapacirung: tapNaziv,
        });
        /* `import.meta.env.BASE_URL` radi i u klijentskoj skripti — Vite ga
           zameni pri gradnji. Bez njega bi veza vodila na koren domena. */
        cta.href = `${import.meta.env.BASE_URL.replace(/\/$/, "")}/kontakt?${upit.toString()}`;
      };

      document
        .querySelectorAll<HTMLInputElement>('input[name="ram"], input[name="tapacirung"]')
        .forEach((r) => r.addEventListener("change", osvezi));

      osvezi();
    }

    return () => posmatraci.forEach((p) => p.disconnect());
  });
</script>
